<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Christmas Card 2026</title>
  <style>
    :root {
      --bg: #0c0e1a;
      --bg-glow: #1d2243;
      --hint: #8f95b8;
      --focus: #ffffff;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      color-scheme: dark;
    }

    html {
      scroll-padding-top: env(safe-area-inset-top, 0px);
    }

    html, body {
      height: 100%;
      margin: 0;
    }

    body {
      background: radial-gradient(ellipse at 50% 40%, var(--bg-glow) 0%, var(--bg) 70%);
      overflow: hidden;
      display: grid;
      place-items: center;
      font-family: "Helvetica Neue", Arial, sans-serif;
      touch-action: none;
    }

    .stage {
      --w: min(88vw, calc(80vh * 0.716));
      width: var(--w);
      aspect-ratio: 63 / 88;
      perspective: 1100px;
    }

    .tilt {
      all: unset;
      display: block;
      width: 100%;
      height: 100%;
      cursor: pointer;
      transform-style: preserve-3d;
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      will-change: transform;
    }

    .tilt:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 12px;
      border-radius: 6%;
    }

    .flip {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform .8s cubic-bezier(.2, .8, .2, 1);
    }

    .flip.is-back {
      transform: rotateY(180deg);
    }

    .face {
      position: absolute;
      inset: 0;
      border-radius: calc(var(--w) * 0.045);
      overflow: hidden;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      box-shadow: 0 30px 70px -20px rgba(0, 0, 0, .8), 0 0 0 1px rgba(255, 255, 255, .06);
      background: #111;
    }

    .face.back {
      transform: rotateY(180deg);
    }

    .face img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      user-select: none;
      -webkit-user-drag: none;
    }

    /* holo laag: regenboog die meebeweegt met de pointer */
    .shine {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(110deg,
      #ff0080 0%, #ffd000 10%, #38ff7a 20%, #00c8ff 30%, #8a4dff 40%, #ff0080 50%);
      background-size: 260% 260%;
      background-position: var(--px, 50%) var(--py, 50%);
      mix-blend-mode: color-dodge;
      filter: brightness(.75) contrast(1.35) saturate(1.2);
      opacity: var(--o, .4);
    }

    /* glans: lichtvlek die de pointer volgt */
    .glare {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(farthest-corner circle at var(--gx, 50%) var(--gy, 50%),
      rgba(255, 255, 255, .85) 0%, rgba(255, 255, 255, .15) 35%, rgba(0, 0, 0, .4) 100%);
      mix-blend-mode: overlay;
      opacity: var(--go, .5);
    }

    .hint {
      position: fixed;
      left: 0;
      right: 0;
      bottom: calc(18px + env(safe-area-inset-bottom, 0px));
      text-align: center;
      font-size: .85rem;
      letter-spacing: .02em;
      color: var(--hint);
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .flip {
        transition-duration: .01s;
      }
    }
  </style>
</head>
<body>

<div class="stage" id="stage">
  <button class="tilt" id="tilt" aria-label="Draai de kaart om">
    <div class="flip" id="flip">
      <div class="face front">
        <img id="imgFront" alt="Voorkant van de kaart" draggable="false">
        <div class="shine"></div>
        <div class="glare"></div>
      </div>
      <div class="face back">
        <img id="imgBack" alt="Achterkant van de kaart" draggable="false">
        <div class="glare"></div>
      </div>
    </div>
  </button>
</div>
<p class="hint">Beweeg over de kaart. Klik of tik om te draaien.</p>

<script>
