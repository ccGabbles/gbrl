  //   return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
  // }

  // var FRONT_SRC = placeholder('Voorkant', '#1b6b8f', '#6a2c91');
  // var BACK_SRC = placeholder('Achterkant', '#1a2a6c', '#b21f1f');
    
  var FRONT_SRC = 'front.png'
  var BACK_SRC = 'back.png'
    
  document.getElementById('imgFront').src = FRONT_SRC;
  document.getElementById('imgBack').src = BACK_SRC;

  /* Tilt + holo */
  var tilt = document.getElementById('tilt');
  var flip = document.getElementById('flip');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var tx = 0, ty = 0, cx = 0, cy = 0, lastMove = -1e9;

  window.addEventListener('pointermove', function(e) {
    tx = Math.max(-1, Math.min(1, (e.clientX / window.innerWidth - 0.5) * 2));
    ty = Math.max(-1, Math.min(1, (e.clientY / window.innerHeight - 0.5) * 2));
    lastMove = performance.now();
  });

  function frame(t) {
    if (!reduce && t - lastMove > 2500) {
      tx = Math.sin(t / 1800) * 0.7;
      ty = Math.cos(t / 2300) * 0.5;
    }
    cx += (tx - cx) * 0.08;
    cy += (ty - cy) * 0.08;
    var s = tilt.style, mag = Math.min(1, Math.hypot(cx, cy));
    s.setProperty('--ry', (cx * 18).toFixed(2) + 'deg');
    s.setProperty('--rx', (-cy * 18).toFixed(2) + 'deg');
    s.setProperty('--px', (50 + cx * 50).toFixed(1) + '%');
    s.setProperty('--py', (50 + cy * 50).toFixed(1) + '%');
    s.setProperty('--gx', (50 + cx * 40).toFixed(1) + '%');
    s.setProperty('--gy', (50 + cy * 40).toFixed(1) + '%');
    s.setProperty('--o', (0.3 + 0.45 * mag).toFixed(2));
    s.setProperty('--go', (0.35 + 0.35 * mag).toFixed(2));
    requestAnimationFrame(frame);
  }

  requestAnimationFrame(frame);

  tilt.addEventListener('click', function() {
    flip.classList.toggle('is-back');
  });
</script>
</body>
</html>
