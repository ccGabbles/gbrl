<!DOCTYPE html>
<html lang="{{ lang or 'nl' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }}</title>
  <style>
    :root {
      --bg: #0c0e1a;
      --bg-glow: #1d2243;
      --hint: #8f95b8;
      --focus: #ffffff;
      /* alternate-art foil texture (from simeydotme/pokemon-cards-css);
         download it into src/assets/images/ and change the url to self-host */
      --illusion-opacity: .2; /* 0 = no pattern, 1 = original strength */
      --imgsize: 50%;
      --illusion: url("https://res.cloudinary.com/simey/image/upload/Dev/PokemonCards/illusion.webp");
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      color-scheme: dark;
    }

    html { scroll-padding-top: env(safe-area-inset-top, 0px); }
    html, body { height: 100%; margin: 0; }

    body {
      background: radial-gradient(ellipse at 50% 40%, var(--bg-glow) 0%, var(--bg) 70%);
      overflow: hidden;
      display: grid;
      place-items: center;
      font-family: "Helvetica Neue", Arial, sans-serif;
      touch-action: none;
    }

    .stage {
      --w: min(88vw, calc(80vh * 0.716));
      width: var(--w);
      aspect-ratio: 63 / 88;
      perspective: 1100px;
    }

    .tilt {
      all: unset;
      display: block;
      width: 100%;
      height: 100%;
      cursor: pointer;
      transform-style: preserve-3d;
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      will-change: transform;
    }

    .tilt:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 12px;
      border-radius: 6%;
    }

    .flip {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform .8s cubic-bezier(.2, .8, .2, 1);
    }

    .flip.is-back { transform: rotateY(180deg); }

    .face {
      position: absolute;
      inset: 0;
      border-radius: calc(var(--w) * 0.045);
      overflow: hidden;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      box-shadow: 0 30px 70px -20px rgba(0, 0, 0, .8), 0 0 0 1px rgba(255, 255, 255, .06);
      background: #111;
    }

    .face.back { transform: rotateY(180deg); }

    .face img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      user-select: none;
      -webkit-user-drag: none;
    }

    /* ---- Alternate art holo (adapted from simeydotme/pokemon-cards-css, "rare ultra") ---- */
    .shine {
      position: absolute;
      inset: 0;
      display: grid;
      pointer-events: none;
      mix-blend-mode: color-dodge;
      opacity: var(--o, .6);
    }

    .shine,
    .shine::after {
      --space: 5%;
      --angle: 133deg;

      background-image:
        repeating-linear-gradient(0deg,
          rgb(255, 119, 115) calc(var(--space) * 1),
          rgba(255, 237, 95, 1) calc(var(--space) * 2),
          rgba(168, 255, 95, 1) calc(var(--space) * 3),
          rgba(131, 255, 247, 1) calc(var(--space) * 4),
          rgba(120, 148, 255, 1) calc(var(--space) * 5),
          rgb(216, 117, 255) calc(var(--space) * 6),
          rgb(255, 119, 115) calc(var(--space) * 7)),
        repeating-linear-gradient(var(--angle),
          #0e152e 0%,
          hsl(180, 10%, 60%) 3.8%,
          hsl(180, 29%, 66%) 4.5%,
          hsl(180, 10%, 60%) 5.2%,
          #0e152e 10%,
          #0e152e 12%),
        radial-gradient(farthest-corner circle at var(--mx, 50%) var(--my, 50%),
          rgba(0, 0, 0, .1) 12%,
          rgba(0, 0, 0, .15) 20%,
          rgba(0, 0, 0, .25) 120%);

      background-blend-mode: hue, hard-light;
      background-size: 200% 700%, 300%, 200%;
      background-position: 0% var(--posy, 50%), var(--posx, 50%) var(--posy, 50%), var(--posx, 50%) var(--posy, 50%);

      filter: brightness(calc((var(--hyp, 0) * 0.3) + 0.5)) contrast(2) saturate(1.5);
    }

    .shine::before,
    .shine::after {
      content: "";
      grid-area: 1 / 1;
    }

    /* the foil pattern lives on its own layer so its strength can be set with --illusion-opacity */
    .shine::before {
      background-image: var(--illusion);
      background-size: var(--imgsize, 50%);
      background-position: center;
      mix-blend-mode: exclusion;
      opacity: var(--illusion-opacity, .25);
    }

    .shine::after {
      background-size: 200% 400%, 195%, 200%;
      background-position: 0% var(--posy, 50%),
        calc(var(--posx, 50%) * -1) calc(var(--posy, 50%) * -1), var(--posx, 50%) var(--posy, 50%);
      filter: brightness(calc((var(--hyp, 0) * 0.5) + 0.8)) contrast(1.6) saturate(1.4);
      mix-blend-mode: exclusion;
    }

    /* glare: light spot following the pointer */
    .glare {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(farthest-corner circle at var(--mx, 50%) var(--my, 50%),
        rgba(255, 255, 255, .8) 10%, rgba(255, 255, 255, .65) 20%, rgba(0, 0, 0, .5) 90%);
      mix-blend-mode: overlay;
      opacity: calc(var(--o, .6) * .8);
    }

    .hint {
      position: fixed;
      left: 0;
      right: 0;
      bottom: calc(18px + env(safe-area-inset-bottom, 0px));
      text-align: center;
      font-size: .85rem;
      letter-spacing: .02em;
      color: var(--hint);
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .flip { transition-duration: .01s; }
    }
  </style>
</head>
<body>

<div class="stage" id="stage">
  <button class="tilt" id="tilt" aria-label="{{ flipLabel or 'Draai de kaart om' }}">
    <div class="flip" id="flip">
      <div class="face front">
        <img src="{{ frontImage }}" alt="{{ frontAlt or 'Voorkant van de kaart' }}" draggable="false">
        <div class="shine"></div>
        <div class="glare"></div>
      </div>
      <div class="face back">
        <img src="{{ backImage }}" alt="{{ backAlt or 'Achterkant van de kaart' }}" draggable="false">
        <div class="glare"></div>
      </div>
    </div>
  </button>
</div>
<p class="hint">{{ hint or 'Beweeg over de kaart. Klik of tik om te draaien.' }}</p>

<script>
  var tilt = document.getElementById('tilt');
  var flip = document.getElementById('flip');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var tx = 0, ty = 0, cx = 0, cy = 0, lastMove = -1e9;

  window.addEventListener('pointermove', function(e) {
    tx = Math.max(-1, Math.min(1, (e.clientX / window.innerWidth - 0.5) * 2));
    ty = Math.max(-1, Math.min(1, (e.clientY / window.innerHeight - 0.5) * 2));
    lastMove = performance.now();
  });

  function frame(t) {
    if (!reduce && t - lastMove > 2500) {
      tx = Math.sin(t / 1800) * 0.7;
      ty = Math.cos(t / 2300) * 0.5;
    }
    cx += (tx - cx) * 0.08;
    cy += (ty - cy) * 0.08;

    var s = tilt.style;
    var hyp = Math.min(1, Math.hypot(cx, cy));
    var px = 50 + cx * 50, py = 50 + cy * 50;   // pointer position in % of the card

    s.setProperty('--ry', (cx * 18).toFixed(2) + 'deg');
    s.setProperty('--rx', (-cy * 18).toFixed(2) + 'deg');
    s.setProperty('--mx', px.toFixed(1) + '%');
    s.setProperty('--my', py.toFixed(1) + '%');
    s.setProperty('--posx', (37 + px * 0.26).toFixed(1) + '%');
    s.setProperty('--posy', (33 + py * 0.34).toFixed(1) + '%');
    s.setProperty('--hyp', hyp.toFixed(3));
    s.setProperty('--o', (0.6 + 0.4 * hyp).toFixed(2));
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  tilt.addEventListener('click', function() {
    flip.classList.toggle('is-back');
  });
</script>
</body>
</html>
